 README.md                         | 11 +++++++++++
 cmd/tailscaled/debug.go           |  4 ++++
 cmd/tailscaled/tailscaled.go      | 30 ++++++++++++++++++++++++++++++
 cmd/tailscaled/tailscaled_test.go | 18 ++++++++++++++++++
