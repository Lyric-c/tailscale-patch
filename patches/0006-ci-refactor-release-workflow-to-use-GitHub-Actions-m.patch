+++ b/.github/workflows/release-custom.yml
@@ -12,8 +12,30 @@ permissions:
   contents: write
 
 jobs:
-  build-and-release:
+  build:
+    name: Build (${{ matrix.os }}/${{ matrix.arch }})
     runs-on: ubuntu-latest
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - os: linux
+            arch: amd64
+            binary_ext: ""
+            archive_type: tar.gz
+          - os: linux
+            arch: arm64
+            binary_ext: ""
+            archive_type: tar.gz
+          - os: darwin
+            arch: arm64
+            binary_ext: ""
+            archive_type: tar.gz
+          - os: windows
+            arch: amd64
+            binary_ext: .exe
+            archive_type: zip
+
     steps:
       - name: Check out code
         uses: actions/checkout@v4
@@ -67,98 +89,71 @@ jobs:
           go-version-file: 'go.mod'
           cache: true
 
-      - name: Build binaries
+      - name: Build and package binary
         run: |
           set -e
           TAG="${{ inputs.tag }}"
+          GOOS="${{ matrix.os }}"
+          GOARCH="${{ matrix.arch }}"
+          EXT="${{ matrix.binary_ext }}"
+          ARCHIVE="${{ matrix.archive_type }}"
+
           mkdir -p dist
+          BUILD_DIR="build/${GOOS}_${GOARCH}"
+          mkdir -p "${BUILD_DIR}"
 
           LDFLAGS="-s -w -X tailscale.com/version.longStamp=${TAG} -X tailscale.com/version.shortStamp=${TAG}"
 
-          echo "Pre-downloading Go dependencies..."
+          echo "Downloading Go modules..."
           go mod download
 
-          echo "Starting parallel compilation for platforms..."
